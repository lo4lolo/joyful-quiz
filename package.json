    "check": "node tools/doctor.mjs",
    "guide": "node tools/build-guide.mjs",
    "release": "node tools/build-guide.mjs && powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-release.ps1"
  },
  "engines": {
    "node": ">=18"
  },
